// Package {{.Slots.store.Package}} implements the {{.Slots.models.Package}}
// interfaces with queries generated by sqlc. The generated code lives in
// package sqlcgen; edit queries.sql and regenerate it instead of editing it.
package {{.Slots.store.Package}}

import (
	"context"
	"fmt"

	"{{.Slots.models.Import}}"
	"{{.Slots.store.Import}}/sqlcgen"
)

// itemStore is a {{.Slots.models.Package}}.ItemStore backed by sqlc queries.
type itemStore struct {
	q *sqlcgen.Queries
}

// New returns a {{.Slots.models.Package}}.ItemStore that stores items in db.
func New(db sqlcgen.DBTX) {{.Slots.models.Package}}.ItemStore {
	return &itemStore{q: sqlcgen.New(db)}
}

func (s *itemStore) List(ctx context.Context) ([]{{.Slots.models.Package}}.Item, error) {
	rows, err := s.q.ListItems(ctx)
	if err != nil {
		return nil, fmt.Errorf("list items: %w", err)
	}
	items := make([]{{.Slots.models.Package}}.Item, len(rows))
	for i, row := range rows {
		items[i] = toModel(row)
	}
	return items, nil
}

func (s *itemStore) Create(ctx context.Context, name string) ({{.Slots.models.Package}}.Item, error) {
	row, err := s.q.CreateItem(ctx, name)
	if err != nil {
		return {{.Slots.models.Package}}.Item{}, fmt.Errorf("create item: %w", err)
	}
	return toModel(row), nil
}

func toModel(row sqlcgen.Item) {{.Slots.models.Package}}.Item {
	return {{.Slots.models.Package}}.Item{ID: row.ID, Name: row.Name, CreatedAt: row.CreatedAt}
}
