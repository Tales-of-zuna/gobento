# sqlc generates Go code from SQL: https://docs.sqlc.dev/
# Regenerate after changing the schema or the queries; see README.md.
version: "2"
sql:
  - engine: sqlite
    schema: {{.Slots.database.Dir}}/{{index .Traits "sql-schema"}}
    queries: {{.Slots.store.Dir}}/queries.sql
    gen:
      go:
        package: sqlcgen
        out: {{.Slots.store.Dir}}/sqlcgen
        omit_sqlc_version: true
