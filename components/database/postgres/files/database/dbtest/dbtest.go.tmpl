// Package dbtest provides databases for tests. They live on the PostgreSQL
// server named by the TEST_DATABASE_URL environment variable; tests that need
// one are skipped when it is unset. Each test gets a schema of its own, with
// the application schema applied, which is dropped when the test ends, so
// packages tested in parallel never see each other's data.
package dbtest

import (
	"context"
	"crypto/rand"
	"database/sql"
	"net/url"
	"os"
	"strings"
	"testing"

	"{{.Slots.database.Import}}"
)

// EnvVar names the environment variable that holds the URL of the test
// server, for example
// postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable.
const EnvVar = "TEST_DATABASE_URL"

// URL returns the connection string of a new, empty schema for the test on
// the test server, dropped when the test ends. The application schema is
// applied when it is opened with {{.Slots.database.Package}}.Open. URL skips
// the test if EnvVar is unset.
func URL(t testing.TB) string {
	t.Helper()
	base := os.Getenv(EnvVar)
	if base == "" {
		t.Skipf("%s is not set; set it to the URL of a PostgreSQL server to run this test", EnvVar)
	}
	u, err := url.Parse(base)
	if err != nil || (u.Scheme != "postgres" && u.Scheme != "postgresql") {
		t.Fatalf("%s must be a postgres:// URL", EnvVar)
	}

	admin, err := sql.Open("pgx", base)
	if err != nil {
		t.Fatalf("connect to %s: %v", EnvVar, err)
	}
	// The name is random and holds only lowercase letters and digits, so it
	// needs no quoting.
	schema := "test_" + strings.ToLower(rand.Text())
	if _, err := admin.ExecContext(t.Context(), "CREATE SCHEMA "+schema); err != nil {
		_ = admin.Close()
		t.Fatalf("create schema on %s: %v", EnvVar, err)
	}
	t.Cleanup(func() {
		if _, err := admin.ExecContext(context.Background(), "DROP SCHEMA "+schema+" CASCADE"); err != nil {
			t.Errorf("drop schema %s: %v", schema, err)
		}
		if err := admin.Close(); err != nil {
			t.Errorf("close connection to %s: %v", EnvVar, err)
		}
	})

	// pgx sends unknown URL parameters to the server as settings.
	q := u.Query()
	q.Set("search_path", schema)
	u.RawQuery = q.Encode()
	return u.String()
}

// Open opens a new, empty database for the test with the schema applied,
// and closes it when the test ends. It skips the test if EnvVar is unset.
func Open(t testing.TB) *sql.DB {
	t.Helper()
	// URL registers dropping the schema first, so the database is closed
	// before it.
	db, err := {{.Slots.database.Package}}.Open(t.Context(), URL(t))
	if err != nil {
		t.Fatalf("open test database: %v", err)
	}
	t.Cleanup(func() {
		if err := db.Close(); err != nil {
			t.Errorf("close test database: %v", err)
		}
	})
	return db
}
