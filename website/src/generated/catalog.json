{
  "kinds": [
    {
      "id": "architecture",
      "title": "Architecture",
      "description": "How the project's packages are laid out and wired together."
    },
    {
      "id": "framework",
      "title": "HTTP framework",
      "description": "Routes HTTP requests to handlers."
    },
    {
      "id": "database",
      "title": "Database",
      "description": "Where the project stores its data."
    },
    {
      "id": "data",
      "title": "Data access",
      "description": "How the code reads and writes the database."
    }
  ],
  "components": [
    {
      "id": "architecture/mvc",
      "kind": "architecture",
      "name": "mvc",
      "title": "Model-View-Controller",
      "description": "Models, controllers, and a data store in separate packages, wired together in cmd/<name>.",
      "provides": {},
      "requires": {}
    },
    {
      "id": "framework/nethttp",
      "kind": "framework",
      "name": "nethttp",
      "title": "net/http",
      "description": "The standard library HTTP server and its pattern-based ServeMux.",
      "provides": {},
      "requires": {}
    },
    {
      "id": "database/sqlite",
      "kind": "database",
      "name": "sqlite",
      "title": "SQLite",
      "description": "SQLite through modernc.org/sqlite, a pure-Go driver that needs no cgo.",
      "provides": {
        "conn": "database/sql",
        "sql-dialect": "sqlite",
        "sql-schema": "schema.sql"
      },
      "requires": {}
    },
    {
      "id": "data/gorm",
      "kind": "data",
      "name": "gorm",
      "title": "GORM",
      "description": "Data access through the GORM ORM, on the database's own connection and schema.",
      "provides": {},
      "requires": {
        "conn": [
          "database/sql"
        ],
        "sql-dialect": [
          "sqlite",
          "postgresql"
        ],
        "sql-schema": [
          "schema.sql"
        ]
      }
    },
    {
      "id": "data/sqlc",
      "kind": "data",
      "name": "sqlc",
      "title": "sqlc",
      "description": "Type-safe Go code generated from SQL queries by sqlc.",
      "provides": {},
      "requires": {
        "conn": [
          "database/sql"
        ],
        "sql-dialect": [
          "sqlite"
        ],
        "sql-schema": [
          "schema.sql"
        ]
      }
    }
  ],
  "go": {
    "range": ">=1.26 <1.28",
    "default": "1.27"
  },
  "modules": [
    {
      "path": "github.com/libtnb/sqlite",
      "components": [
        "data/gorm"
      ],
      "traits": {
        "sql-dialect": [
          "sqlite"
        ]
      },
      "role": "library",
      "range": ">=v1.1.0 <v2.0.0",
      "default": "v1.2.2",
      "constraints": [
        {
          "when": ">=v1.2.0",
          "requires": {
            "target": "gorm.io/gorm",
            "range": ">=v1.31.2"
          }
        }
      ]
    },
    {
      "path": "github.com/sqlc-dev/sqlc",
      "components": [
        "data/sqlc"
      ],
      "traits": {},
      "role": "tool",
      "range": "=v1.31.1",
      "default": "v1.31.1",
      "constraints": []
    },
    {
      "path": "gorm.io/driver/postgres",
      "components": [
        "data/gorm"
      ],
      "traits": {
        "sql-dialect": [
          "postgresql"
        ]
      },
      "role": "library",
      "range": ">=v1.6.1 <v2.0.0",
      "default": "v1.6.3",
      "constraints": [
        {
          "when": ">=v1.6.2",
          "requires": {
            "target": "gorm.io/gorm",
            "range": ">=v1.31.2"
          }
        }
      ]
    },
    {
      "path": "gorm.io/gorm",
      "components": [
        "data/gorm"
      ],
      "traits": {},
      "role": "library",
      "range": ">=v1.31.1 <v2.0.0",
      "default": "v1.31.2",
      "constraints": []
    },
    {
      "path": "modernc.org/sqlite",
      "components": [
        "database/sqlite"
      ],
      "traits": {},
      "role": "library",
      "range": ">=v1.61.0 <v2.0.0",
      "default": "v1.61.1",
      "constraints": [
        {
          "when": ">=v1.61.0",
          "requires": {
            "target": "go",
            "range": ">=1.26"
          }
        }
      ]
    }
  ],
  "supported": [
    {
      "architecture": "mvc",
      "data": "gorm",
      "database": "sqlite",
      "framework": "nethttp"
    },
    {
      "architecture": "mvc",
      "data": "sqlc",
      "database": "sqlite",
      "framework": "nethttp"
    }
  ],
  "rules": {
    "projectName": {
      "pattern": "^[a-z][a-z0-9_-]*$",
      "message": "Start with a lowercase letter and use only lowercase letters, digits, - and _.",
      "reserved": [
        "con",
        "prn",
        "aux",
        "nul",
        "com1",
        "com2",
        "com3",
        "com4",
        "com5",
        "com6",
        "com7",
        "com8",
        "com9",
        "lpt1",
        "lpt2",
        "lpt3",
        "lpt4",
        "lpt5",
        "lpt6",
        "lpt7",
        "lpt8",
        "lpt9"
      ],
      "reservedMessage": "The name is reserved on Windows and cannot be used for files or directories; choose another name."
    },
    "modulePath": {
      "pattern": "^(?:[A-Za-z0-9_~+]|[A-Za-z0-9._~+][A-Za-z0-9._~+-]*[A-Za-z0-9_~+-])(?:/[A-Za-z0-9._~+-]*[A-Za-z0-9_~+-])*$",
      "message": "Use a Go module path such as example.com/shop: elements of letters, digits, '.', '_', '~', '+' and '-', separated by '/', none ending in '.'."
    }
  }
}
