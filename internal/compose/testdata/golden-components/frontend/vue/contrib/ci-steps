- uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
  with:
    node-version: 26
    cache: npm
    cache-dependency-path: frontend/package-lock.json
- name: Install the frontend dependencies
  working-directory: frontend
  run: npm ci
- name: Lint and check the frontend
  working-directory: frontend
  # The scripts the scaffolded project defines, if any.
  run: |
    npm run --if-present lint
    npm run --if-present check
- name: Build the frontend
  working-directory: frontend
  # Type-checks and builds into internal/views/dist/app, which the Go build embeds.
  run: npm run build
